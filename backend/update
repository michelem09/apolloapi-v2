#!/bin/bash
# Apollo updater — installs a signed, pre-built release over the checkout.
#
# Replaces "git pull + yarn install + next build on the device", which took
# 10–20 minutes and peaked enough RAM to take the box down. The release is built
# and signed by CI; the device only verifies and unpacks it.
#
# Deliberately NOT the release-layout OTA (releases/<v> + current symlink): the
# update mechanism itself never changes, so a bad release is corrected by the
# next one through the same still-working path. See OTA_UPDATE_REDESIGN.md §5.1.
#
# The directories the release owns are replaced wholesale, so a file deleted
# upstream really disappears. bitcoind under backend/node/bin is the single
# documented exception, carried across the swap to keep the artifact ~40 MB
# instead of ~150 MB.
set -Eeuo pipefail

YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
TMPFILE='/tmp/update_progress'
SOLO_REQUEST_FILE='/run/apollo-update-solo-requested-status'
APOLLO_DIR="${APOLLO_ROOT_DIR:-/opt/apolloapi}"
UI_DIR="${APOLLO_DIR}/apolloui-v2"
STATE_DIR="${APOLLO_STATE_DIR:-/var/lib/apollo}"
TRUST_CONF="${APOLLO_TRUST_CONF:-/etc/apollo/update.conf}"
DL_DIR="${STATE_DIR}/cache/dl"
BACKUP_DIR="${STATE_DIR}/backups"
OFFICIAL_OWNER='jstefanop'
OFFICIAL_REPO='apolloapi-v2'
HEALTH_URL="${APOLLO_HEALTH_URL:-http://localhost:5000/health}"
UI_HEALTH_URL="${APOLLO_UI_HEALTH_URL:-http://localhost:3000/}"
HEALTH_TIMEOUT="${APOLLO_HEALTH_TIMEOUT:-90}"
VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.]*)?$'

STAGING=''; TARBALL=''
# MUTATED is armed BEFORE the first destructive step, not after the last one: it
# answers "might /opt/apolloapi be half-dismantled?", and a flag set afterwards
# was still 0 during the exact window it exists to cover.
MUTATED=0; STOPPED=0; UNITS_SAVED=0; COMPLETED=0

log()  { echo -e "${YELLOW} ---> $*${NC}"; }
err()  { echo -e "${RED}$*${NC}" >&2; }
die()  { err "$*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# Sourced with APOLLO_UPDATE_LIB=1 by tests/ota/rollback.test.sh, which drives the
# backup and restore functions directly under injected failures. The update itself
# never sets it, and sudo's env_reset means it cannot arrive from outside.
if [ -z "${APOLLO_UPDATE_LIB:-}" ]; then

[ "$EUID" -eq 0 ] || die "Update script must be run by root or with sudo"

# --- get out of the caller's cgroup ------------------------------------------
# The UI spawns this script as a child of apollo-api (src/services/mcu.js uses a
# plain spawn, with no setsid or detached), so it runs inside that unit's cgroup
# — and one of the first things it does is stop apollo-api.service. systemd's
# default KillMode=control-group makes that a SIGTERM to ourselves, in the middle
# of the swap, leaving every service stopped and nothing to start them again.
#
# A run started by hand over SSH already lives in the session scope and was never
# at risk, which is exactly why testing it that way did not reveal this.
#
# Output goes to a log file rather than staying on the inherited stdout: that pipe
# belongs to the process we are about to stop, and writing to it afterwards would
# fail under `set -e` — trading one self-inflicted abort for another.
LOG_FILE="${APOLLO_UPDATE_LOG:-$STATE_DIR/update.log}"
if [ -z "${APOLLO_UPDATE_SCOPED:-}" ] && [ -d /run/systemd/system ] && have systemd-run; then
  mkdir -p "$STATE_DIR"
  echo "Update started. Follow it with: tail -f $LOG_FILE"
  export APOLLO_UPDATE_SCOPED=1
  exec systemd-run --quiet --scope -- "$0" "$@"
fi
if [ -n "${APOLLO_UPDATE_SCOPED:-}" ]; then
  mkdir -p "$STATE_DIR"
  exec >>"$LOG_FILE" 2>&1
  echo "=== update started $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
fi

fi  # end of the non-library preamble

# --- config, parsed and never executed --------------------------------------
# source.conf is writable by the app user, so sourcing it would be code
# execution as root. Read the keys instead.
conf_get() {  # file key
  [ -r "$1" ] || return 0
  sed -n "s/^[[:space:]]*$2=//p" "$1" | tail -n 1 \
    | sed -e 's/[[:space:]]*#.*$//' -e 's/\r$//' -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'\$//"
}

SOURCE_CONF="${APOLLO_SOURCE_CONF:-$STATE_DIR/source.conf}"
GIT_BASE="$(conf_get "$SOURCE_CONF" APOLLO_GIT_BASE)"; GIT_BASE="${GIT_BASE:-https://github.com/$OFFICIAL_OWNER}"
API_REPO="$(conf_get "$SOURCE_CONF" APOLLO_API_REPO)"; API_REPO="${API_REPO:-$OFFICIAL_REPO}"
CHANNEL="$(conf_get "$SOURCE_CONF" APOLLO_CHANNEL)";   CHANNEL="${CHANNEL:-stable}"
CHANNEL_URL="${APOLLO_CHANNEL_URL:-${GIT_BASE}/${API_REPO}/releases/download/channel-${CHANNEL}/${CHANNEL}.json}"

# Which identity to trust is a root-only decision: source.conf only says where to
# fetch, and a wrong value there must not be able to change what we accept.
default_identity="^https://github\\.com/${OFFICIAL_OWNER}/${OFFICIAL_REPO}/\\.github/workflows/release\\.yml@refs/tags/v"
TRUST_IDENTITY="$(conf_get "$TRUST_CONF" APOLLO_TRUST_IDENTITY)"; TRUST_IDENTITY="${TRUST_IDENTITY:-$default_identity}"
TRUST_ISSUER="$(conf_get "$TRUST_CONF" APOLLO_TRUST_ISSUER)";     TRUST_ISSUER="${TRUST_ISSUER:-https://token.actions.githubusercontent.com}"

# --- helpers -----------------------------------------------------------------
sha256_of() { sha256sum "$1" | cut -d' ' -f1; }

# Semver-aware. `sort -V` is not: it orders 2.2.0-rc1 ABOVE 2.2.0, which would
# leave every beta device thinking it is already up to date.
version_gt() {  # $1 > $2 ?
  local a="$1" b="$2" ac bc ap bp i x y
  ac="${a%%-*}"; bc="${b%%-*}"
  [ "$a" = "$ac" ] && ap='' || ap="${a#*-}"
  [ "$b" = "$bc" ] && bp='' || bp="${b#*-}"
  local -a A B; IFS=. read -ra A <<<"$ac"; IFS=. read -ra B <<<"$bc"
  for i in 0 1 2; do
    x=$((10#${A[i]:-0})); y=$((10#${B[i]:-0}))
    [ "$x" -gt "$y" ] && return 0
    [ "$x" -lt "$y" ] && return 1
  done
  # Cores equal: a release outranks any prerelease of the same core.
  [ -z "$ap" ] && [ -n "$bp" ] && return 0
  [ -n "$ap" ] && [ -z "$bp" ] && return 1
  [ "$ap" = "$bp" ] && return 1
  [ "$(printf '%s\n%s\n' "$ap" "$bp" | sort | tail -n 1)" = "$ap" ]
}

valid_version() { printf '%s' "$1" | grep -qE "$VERSION_RE"; }
# A field starting with '-' would be read by curl as an option (e.g. -K reads a
# config file), so every URL is schema-checked and passed after --url.
valid_url() { printf '%s' "$1" | grep -qE '^https://[A-Za-z0-9._~:/?#@!$&()*+,;=%-]+$'; }

fetch() { curl -fsSL --retry 3 --connect-timeout 15 --max-time 120 --url "$1"; }

current_version() {
  if [ -f "$APOLLO_DIR/version.json" ]; then jq -r '.version // empty' "$APOLLO_DIR/version.json"
  elif [ -f "$APOLLO_DIR/package.json" ]; then jq -r '.version // empty' "$APOLLO_DIR/package.json"
  fi
}

resolve_database_url() {
  local from_env candidate
  from_env="$(conf_get "$APOLLO_DIR/.env" DATABASE_URL)"
  for candidate in "$from_env" "$STATE_DIR/db/futurebit.sqlite" "$APOLLO_DIR/futurebit.sqlite"; do
    [ -n "$candidate" ] && [ -f "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
  done
  return 1
}

restore_solo_intent() {
  [ -f "$SOLO_REQUEST_FILE" ] || return 0
  local db requested
  if ! db="$(resolve_database_url)"; then
    err "Could not locate the database; keeping preserved solo intent"; return 0
  fi
  requested="$(<"$SOLO_REQUEST_FILE")"
  case "$requested" in
    online|offline) sqlite3 "$db" "UPDATE service_status SET status='pending', requested_status='${requested}', requested_at=CURRENT_TIMESTAMP WHERE service_name='solo';" ;;
    '')             sqlite3 "$db" "UPDATE service_status SET requested_status=NULL, requested_at=NULL WHERE service_name='solo';" ;;
  esac
  rm -f "$SOLO_REQUEST_FILE"
}

# Any abort must leave the device on working code and no debris behind — the
# previous design leaked a half-extracted tree and a partial tarball.
#
# Success is tracked with an explicit flag rather than inferred from $?. When the
# shell dies on a signal the EXIT trap can run with $? == 0, which took the
# success branch and skipped the rollback entirely — on the one path where the
# rollback is the whole point.
cleanup() {
  local status=$?
  trap - ERR EXIT TERM INT HUP
  [ -n "$STAGING" ] && rm -rf "$STAGING"

  if [ "$COMPLETED" -eq 1 ]; then exit 0; fi
  [ "$status" -eq 0 ] && status=1

  [ -n "$TARBALL" ] && rm -f "$TARBALL" "$TARBALL.sig" "$TARBALL.pem"
  if [ "$MUTATED" -eq 1 ]; then
    restore_code || err "ROLLBACK FAILED — this device needs manual recovery over SSH"
  fi
  # Restarting is unconditional once anything has been stopped: an explicit `die`
  # between the stop and the end used to leave the API, UI, node and ckpool all
  # down, with no Restart= recovery because the stop was deliberate.
  if [ "$STOPPED" -eq 1 ]; then
    err "Restarting services"
    start_services
  fi
  restore_solo_intent || true
  rm -f "$TMPFILE"
  err "Update failed; the previous version is still installed"
  exit "$status"
}
if [ -z "${APOLLO_UPDATE_LIB:-}" ]; then
  trap cleanup ERR EXIT
  # Without these the shell dies on the signal and the EXIT trap misreads it as
  # success. The self-SIGTERM this used to cause is fixed above, but a manual
  # `kill`, an SSH hangup or a shutdown mid-update are all still real.
  trap 'exit 143' TERM INT HUP
fi

# --- code swap ---------------------------------------------------------------
# Directories the release fully owns. Replaced wholesale — never merged — so a
# file deleted upstream actually disappears from the device. Merging would make
# a deletion silently ineffective, including one that IS the security fix.
OWNED='src config migrations node_modules backend'

# The single exception: bitcoind (~103 MB across flavours) is deliberately not in
# the artifact, so it is carried across the swap instead of being deleted with
# the rest of backend/. Keeping it to ONE explicit path is the point — a forgotten
# entry here fails loudly at startup, which is far safer than the silent staleness
# a merge would leave behind. Step 6 (bitcoind as its own package) removes even this.
PRESERVED_BIN="$BACKUP_DIR/.preserved-node-bin"

# Root-level files the release owns. version.json matters most: it is what the
# device believes it is running, so a rollback that leaves the new one behind
# makes every later update exit "Already on <version>" against old code — an OTA
# dead end that only SSH can undo.
ROOT_FILES='knexfile.js package.json version.json'

# systemd units the release installs. Named once so the backup and the install
# cannot drift apart and leave a unit un-revertable.
UNITS='apollo-bootstrap apollo-api apollo-ui-v2 apollo-miner node ckpool rc-local swap'

preserve_binaries() {
  rm -rf "$PRESERVED_BIN"
  [ -d "$APOLLO_DIR/backend/node/bin" ] && mv "$APOLLO_DIR/backend/node/bin" "$PRESERVED_BIN"
  return 0
}

# Rollback-safe counterpart. It must never delete $PRESERVED_BIN: between
# preserve_binaries and place_binaries that directory holds the device's ONLY
# copy of bitcoind, because the artifact ships none. Calling preserve_binaries
# here — whose first act is `rm -rf "$PRESERVED_BIN"` — destroyed it, and the
# rollback then "succeeded" with zero bitcoind on the device and no release able
# to put it back.
rescue_binaries() {
  [ -d "$PRESERVED_BIN" ] && return 0
  [ -d "$APOLLO_DIR/backend/node/bin" ] && mv "$APOLLO_DIR/backend/node/bin" "$PRESERVED_BIN"
  return 0
}

place_binaries() {
  if [ ! -d "$PRESERVED_BIN" ]; then
    [ -d "$APOLLO_DIR/backend/node/bin" ] \
      || err "WARNING: no bitcoind found on this device — the node cannot start"
    return 0
  fi
  mkdir -p "$APOLLO_DIR/backend/node"
  rm -rf "$APOLLO_DIR/backend/node/bin"
  mv "$PRESERVED_BIN" "$APOLLO_DIR/backend/node/bin"
}

backup_code() {
  BACKUP_CODE="$BACKUP_DIR/code-pre-$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$BACKUP_CODE"
  # Written before anything moves. Written afterwards, a failure partway through
  # the move loop left the tree dismantled and no pointer to what held it.
  printf '%s\n' "$BACKUP_CODE" > "$BACKUP_DIR/.last-code-backup"
  local d f
  for d in $OWNED; do [ -e "$APOLLO_DIR/$d" ] && mv "$APOLLO_DIR/$d" "$BACKUP_CODE/$d"; done
  [ -e "$UI_DIR/.next" ] && { mkdir -p "$BACKUP_CODE/apolloui-v2"; mv "$UI_DIR/.next" "$BACKUP_CODE/apolloui-v2/.next"; }
  for f in $ROOT_FILES; do [ -e "$APOLLO_DIR/$f" ] && cp -p "$APOLLO_DIR/$f" "$BACKUP_CODE/$f"; done
  return 0
}

backup_units() {
  UNIT_BACKUP="$BACKUP_DIR/units-pre-$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$UNIT_BACKUP"
  local unit
  for unit in $UNITS; do
    [ -f "/etc/systemd/system/$unit.service" ] \
      && cp -p "/etc/systemd/system/$unit.service" "$UNIT_BACKUP/$unit.service"
  done
  [ -f /etc/rc.local ] && cp -p /etc/rc.local "$UNIT_BACKUP/rc.local"
  UNITS_SAVED=1
  return 0
}

restore_units() {
  [ "$UNITS_SAVED" -eq 1 ] && [ -d "${UNIT_BACKUP:-}" ] || return 0
  err "Restoring the previous systemd units"
  local unit
  for unit in $UNITS; do
    [ -f "$UNIT_BACKUP/$unit.service" ] \
      && install -m 644 "$UNIT_BACKUP/$unit.service" "/etc/systemd/system/$unit.service"
  done
  [ -f "$UNIT_BACKUP/rc.local" ] && install -m 755 "$UNIT_BACKUP/rc.local" /etc/rc.local
  systemctl daemon-reload || true
  return 0
}

# Same set the success path starts, and in the same order: bootstrap first,
# because node and apollo-miner Require it. ckpool is deliberately absent — its
# intent lives in the database and serviceMonitor acts on it.
start_services() {
  systemctl start apollo-bootstrap.service || true
  systemctl start apollo-api.service apollo-ui-v2.service || true
  systemctl start node.service apollo-miner.service || true
  return 0
}

restore_code() {
  local b; b="${BACKUP_CODE:-$(cat "$BACKUP_DIR/.last-code-backup" 2>/dev/null || true)}"
  [ -n "$b" ] && [ -d "$b" ] || { err "No code backup to restore from"; return 1; }
  err "Restoring the previous code from $b"
  rescue_binaries
  local d f
  for d in $OWNED; do rm -rf "$APOLLO_DIR/$d"; [ -e "$b/$d" ] && mv "$b/$d" "$APOLLO_DIR/$d"; done
  rm -rf "$UI_DIR/.next"; [ -e "$b/apolloui-v2/.next" ] && mv "$b/apolloui-v2/.next" "$UI_DIR/.next"
  place_binaries
  # Absent in the backup means absent before the update — the file must go, not
  # survive as the new release's copy.
  for f in $ROOT_FILES; do
    if [ -e "$b/$f" ]; then cp -p "$b/$f" "$APOLLO_DIR/$f"; else rm -f "$APOLLO_DIR/$f"; fi
  done
  chown -R futurebit:futurebit "$APOLLO_DIR" || true
  restore_units
  return 0
}

health_ok() {
  local deadline=$(( $(date +%s) + HEALTH_TIMEOUT ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    # -L: the UI answers / with a 308 to /overview, which -fsS alone would accept
    # even from a server that cannot serve a page.
    if curl -fsS --max-time 5 --url "$HEALTH_URL" >/dev/null 2>&1 \
       && curl -fsSL --max-time 5 --url "$UI_HEALTH_URL" >/dev/null 2>&1; then return 0; fi
    sleep 3
  done
  return 1
}

# --- run ---------------------------------------------------------------------
# Everything above is definitions; the tests source the file to here and stop.
[ -n "${APOLLO_UPDATE_LIB:-}" ] && return 0

rm -f "$TMPFILE"; echo "5" > "$TMPFILE"

for t in curl jq zstd sha256sum sqlite3 cosign; do
  have "$t" || die "Missing dependency: $t (install it before updating)"
done

# The channel URL is assembled from source.conf, which the app user can write, so
# it gets the same schema check as the URLs inside the manifest. Without it an
# APOLLO_GIT_BASE of http://… downgrades the fetch and makes the manifest — the
# input to everything below — trivially MITM-able.
valid_url "$CHANNEL_URL" || die "Update channel is not a plain https URL"

log "Checking ${CHANNEL} channel"
MANIFEST="$(fetch "$CHANNEL_URL")" || die "Cannot reach the update channel"
VERSION="$(jq -r '.version // empty' <<<"$MANIFEST")"
URL="$(jq -r '.url // empty' <<<"$MANIFEST")"
SIG_URL="$(jq -r '.signature_url // empty' <<<"$MANIFEST")"
CERT_URL="$(jq -r '.certificate_url // empty' <<<"$MANIFEST")"
SHA="$(jq -r '.sha256 // empty' <<<"$MANIFEST")"
SIZE="$(jq -r '.size // 0' <<<"$MANIFEST")"

valid_version "$VERSION" || die "Manifest version '$VERSION' is not a valid version"
for u in "$URL" "$SIG_URL" "$CERT_URL"; do
  valid_url "$u" || die "Manifest contains a URL that is not a plain https URL"
done
printf '%s' "$SHA" | grep -qE '^[0-9a-f]{64}$' || die "Manifest sha256 is malformed"
# SIZE is used in an arithmetic expansion below, and bash re-evaluates a variable's
# value there as an expression — array subscripts inside it undergo full expansion,
# so an unvalidated size of the form `x[$(cmd)]` runs cmd as root. That happens
# BEFORE the checksum and cosign checks, which would bypass signing entirely.
printf '%s' "$SIZE" | grep -qE '^[0-9]+$' || die "Manifest size is malformed"

CURRENT="$(current_version || true)"
if [ -n "$CURRENT" ] && valid_version "$CURRENT"; then
  [ "$CURRENT" = "$VERSION" ] && { log "Already on $VERSION"; rm -f "$TMPFILE"; exit 0; }
  version_gt "$VERSION" "$CURRENT" || die "Refusing to move from $CURRENT to older/equal $VERSION"
fi

# Peak usage is the tarball plus the unpacked tree plus the backup of what it
# replaces; ask for a generous multiple of the artifact size.
NEED_KB=$(( (SIZE / 1024) * 4 + 262144 ))
FREE_KB=$(df -Pk "$APOLLO_DIR" | awk 'NR==2 {print $4}')
[ "$FREE_KB" -ge "$NEED_KB" ] || die "Not enough disk space: need ~$((NEED_KB/1024)) MB, have $((FREE_KB/1024)) MB"

log "Downloading $VERSION"
echo "15" > "$TMPFILE"
mkdir -p "$DL_DIR" "$BACKUP_DIR"
TARBALL="$DL_DIR/apollo-${VERSION}-aarch64.tar.zst"
# Never resume onto a complete-but-wrong file: verify a cached copy, else refetch.
if [ -f "$TARBALL" ] && [ "$(sha256_of "$TARBALL")" = "$SHA" ]; then
  log "Using verified cached download"
else
  rm -f "$TARBALL"
  curl -fL --retry 3 --connect-timeout 15 --max-time 1800 -o "$TARBALL" --url "$URL"
fi
curl -fsSL --max-time 120 -o "$TARBALL.sig"  --url "$SIG_URL"
curl -fsSL --max-time 120 -o "$TARBALL.pem"  --url "$CERT_URL"

echo "35" > "$TMPFILE"
log "Verifying"
GOT="$(sha256_of "$TARBALL")"
[ "$GOT" = "$SHA" ] || die "Checksum mismatch (expected $SHA, got $GOT)"
cosign verify-blob --certificate "$TARBALL.pem" --signature "$TARBALL.sig" \
  --certificate-identity-regexp "$TRUST_IDENTITY" \
  --certificate-oidc-issuer "$TRUST_ISSUER" "$TARBALL" >/dev/null 2>&1 \
  || die "Signature verification failed — refusing to install"

echo "45" > "$TMPFILE"
log "Unpacking"
STAGING="$(mktemp -d "${APOLLO_DIR}/.staging.XXXXXX")"
tar -C "$STAGING" --zstd --no-same-owner -xf "$TARBALL"
STAGED_VERSION="$(jq -r '.version // empty' "$STAGING/version.json" 2>/dev/null || true)"
[ "$STAGED_VERSION" = "$VERSION" ] || die "Artifact is version '$STAGED_VERSION', manifest said '$VERSION'"
[ -f "$STAGING/apolloui-v2/.next/standalone/server.js" ] || die "Artifact has no standalone UI server"

# Preserve solo intent before anything stops. /run is cleared on reboot.
if [ ! -e "$SOLO_REQUEST_FILE" ] && db="$(resolve_database_url)"; then
  requested="$(sqlite3 "$db" "SELECT COALESCE(requested_status,'') FROM service_status WHERE service_name='solo' ORDER BY id DESC LIMIT 1;" 2>/dev/null || true)"
  (umask 077; printf '%s\n' "$requested" > "$SOLO_REQUEST_FILE")
fi

echo "60" > "$TMPFILE"
log "Stopping services"
# Armed before the stop, so a failure during it still restarts what went down.
STOPPED=1
# Everything the release owns is stopped, not just what reads from the checkout.
# `systemctl start` on an already-active unit is a no-op, so a unit left running
# here is a unit that never picks up the new release — the v2.2 script got away
# with a partial list only because it ended in a reboot. apollo-miner kept running
# the old binary out of the backup directory; apollo-bootstrap is Type=oneshot
# with RemainAfterExit=yes, so leaving it active meant its migrations never ran.
#
# Order matters: node and apollo-miner have Requires=apollo-bootstrap, so
# bootstrap goes last on the way down and first on the way up.
systemctl stop ckpool.service node.service apollo-miner.service \
  apollo-ui-v2.service apollo-api.service apollo-bootstrap.service
if systemctl is-active --quiet node.service || pgrep -u futurebit -x bitcoind >/dev/null 2>&1; then
  die "Bitcoin node did not stop cleanly; aborting update"
fi
# ckpool needs its own check and not belt-and-braces: ckpool_stop.sh ends in
# `|| true` and ckpool_start.sh daemonises with -B, so `systemctl stop` reports
# success with the process still alive. An orphan keeps the stratum port and the
# pre-update config, and the new instance then cannot bind.
if pgrep -u futurebit -x ckpool >/dev/null 2>&1; then
  die "ckpool did not stop cleanly; aborting update"
fi

echo "70" > "$TMPFILE"
log "Installing $VERSION"
MUTATED=1
preserve_binaries
backup_code
for d in $OWNED; do [ -e "$STAGING/$d" ] && mv "$STAGING/$d" "$APOLLO_DIR/$d"; done
mkdir -p "$UI_DIR/.next"
mv "$STAGING/apolloui-v2/.next/standalone" "$UI_DIR/.next/standalone"
place_binaries
for f in $ROOT_FILES; do
  [ -e "$STAGING/$f" ] && cp "$STAGING/$f" "$APOLLO_DIR/$f"
done
# Device state lives outside the release and is never touched: .env,
# apolloui-v2/.env, and everything under the state dir.
chown -R futurebit:futurebit "$APOLLO_DIR"

echo "85" > "$TMPFILE"
log "Applying units and configuration"
# Snapshot the live units first: they are overwritten and enabled below, and a
# rollback that restores only the code leaves the device booting old code under
# the new release's units.
backup_units
for unit in $UNITS; do
  [ -f "$APOLLO_DIR/backend/systemd/$unit.service" ] \
    && install -m 644 "$APOLLO_DIR/backend/systemd/$unit.service" "/etc/systemd/system/$unit.service"
done
[ -f "$APOLLO_DIR/backend/rc.local" ] && install -m 755 "$APOLLO_DIR/backend/rc.local" /etc/rc.local
systemctl daemon-reload
systemctl enable apollo-bootstrap.service apollo-api.service apollo-ui-v2.service \
  apollo-miner.service node.service rc-local.service >/dev/null 2>&1 || true

# The firewall is applied directly rather than by restarting rc-local.service:
# rc.local also runs backend/first_run, which partitions, mounts and resizes
# storage — not something to repeat mid-update. backend/firewall is safe to
# re-run on its own because it opens by flushing every chain.
if [ -x "$APOLLO_DIR/backend/firewall" ]; then
  "$APOLLO_DIR/backend/firewall" >/dev/null 2>&1 || err "Firewall rules were not applied"
fi

restore_solo_intent

echo "95" > "$TMPFILE"
log "Starting services"
# bootstrap first: it owns the migrations, and node/miner Require it, so starting
# it later would bounce them right after they came up.
systemctl start apollo-bootstrap.service
systemctl start apollo-api.service apollo-ui-v2.service
# A node that will not start is a failed update — health_ok only probes the API
# and the UI, so without this a device with a dead Bitcoin node reported success.
# ExecCondition (node_storage_ready.sh) declining is not a failure, so a device
# whose disk is not ready still passes here.
systemctl start node.service || die "Bitcoin node did not start after installing $VERSION"
# The miner stays a warning: solo-node devices have no miner hardware at all.
systemctl start apollo-miner.service || err "The miner did not start cleanly"
health_ok || die "Health check failed after installing $VERSION"

echo "100" > "$TMPFILE"
COMPLETED=1
log "Updated to $VERSION"
rm -f "$TMPFILE"
