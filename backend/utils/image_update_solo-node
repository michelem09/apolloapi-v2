#!/bin/bash
set -Eeuo pipefail

YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

# FACTORY IMAGE BUILD TOOL — DESTRUCTIVE BY DESIGN.
# This script updates a live Solo Node image-building system before it is shut
# down and captured for production SD cards. It intentionally removes all
# device-local database and runtime credential state, and leaves services
# stopped. Never run this script on a deployed customer device.

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}Image update must be run by root or with sudo${NC}"
    exit 1
fi

APOLLO_DIR='/opt/apolloapi'
UI_DIR="${APOLLO_DIR}/apolloui-v2"
STATE_DIR='/var/lib/apollo'

echo -e "${YELLOW} ---> Stopping image services${NC}"
for unit in \
    apollo-api.service \
    apollo-ui-v2.service \
    ckpool.service \
    apollo-miner.service \
    node.service \
    apollo-bootstrap.service; do
    systemctl stop "$unit" >/dev/null 2>&1 || true
    if systemctl is-active --quiet "$unit"; then
        echo -e "${RED}Could not stop ${unit}; refusing to sanitize the image${NC}" >&2
        exit 1
    fi
done

#### SYSTEM PACKAGES ####
#########################
echo -e "${YELLOW} ---> Installing and upgrading required system packages${NC}"
apt-get update
# The Armbian packages own /etc/armbian-release, so this upgrade rewrites it and
# resets BOARD_NAME — which un-identifies an Apollo III: the UI renders Apollo
# I/II controls and miner_start.sh launches the USB miner that is not there.
BOARD_NAME_BEFORE=""
if [ -r /etc/armbian-release ]; then
    BOARD_NAME_BEFORE=$(grep -E "^BOARD_NAME=" /etc/armbian-release || true)
fi

apt-get -y upgrade

if [ -n "$BOARD_NAME_BEFORE" ] && [ -r /etc/armbian-release ]; then
    if ! grep -qxF "$BOARD_NAME_BEFORE" /etc/armbian-release; then
        echo -e "${YELLOW} ---> Restoring ${BOARD_NAME_BEFORE} (reset by the upgrade)${NC}"
        if grep -qE "^BOARD_NAME=" /etc/armbian-release; then
            sed -i "s|^BOARD_NAME=.*|${BOARD_NAME_BEFORE}|" /etc/armbian-release
        else
            echo "$BOARD_NAME_BEFORE" >> /etc/armbian-release
        fi
    fi
fi

git config --global --add safe.directory "$APOLLO_DIR"
git config --global --add safe.directory "$UI_DIR"

# Where to pull from. source.conf is authoritative: a device installed from one
# source can be pointed at another, but its checkout keeps the remote it was
# cloned with until we reconcile it here.
. "${APOLLO_DIR}/backend/lib/source-config.sh"
echo -e "${YELLOW} ---> Code source: ${APOLLO_GIT_BASE}${NC}"
git -C "$APOLLO_DIR" remote set-url origin "$APOLLO_API_URL"
git -C "$UI_DIR" remote set-url origin "$APOLLO_UI_URL"
chown -R futurebit:futurebit "$APOLLO_DIR"

### API ###
#############
echo -e "${YELLOW} ---> Updating API modules${NC}"
git -C "$APOLLO_DIR" reset --hard
git -C "$APOLLO_DIR" pull --ff-only

# Node and yarn come from the runtime this checkout pins (.nvmrc), fetched only
# after the pull so the script and its checksums are the new ones. nvm is no
# longer used: the units, the OTA artifact and this script all run the same Node.
echo -e "${YELLOW} ---> Installing the Node.js runtime${NC}"
bash "${APOLLO_DIR}/backend/utils/install-node-runtime.sh"
export PATH="${APOLLO_DIR}/backend/runtime/node/bin:${PATH}"

cd "$APOLLO_DIR"
yarn

### UI ###
############
echo -e "${YELLOW} ---> Updating UI modules${NC}"
git -C "$UI_DIR" reset --hard
git -C "$UI_DIR" pull --ff-only

API_BRANCH=$(git -C "$APOLLO_DIR" rev-parse --abbrev-ref HEAD)
UI_BRANCH=$(git -C "$UI_DIR" rev-parse --abbrev-ref HEAD)

# image_install falls back to the UI's dev branch when a backend branch has no UI
# counterpart, so a mismatch is only fatal on main/staging.
is_release_branch() {
    [ "$1" = "main" ] || [ "$1" = "staging" ]
}

if [ "$API_BRANCH" != "$UI_BRANCH" ]; then
    if is_release_branch "$API_BRANCH" || is_release_branch "$UI_BRANCH"; then
        echo -e "${RED} ---> API is on $API_BRANCH but the UI is on $UI_BRANCH, refusing to capture a mixed release image${NC}" >&2
        exit 1
    fi
    echo -e "${YELLOW} ---> API is on $API_BRANCH, UI is on $UI_BRANCH (developer image)${NC}" >&2
fi

cd "$UI_DIR"
yarn

echo -e "${YELLOW} ---> Building UI (could take a few minutes)${NC}"
rm -rf .next
yarn build

yarn cache clean

chown -R futurebit:futurebit "$APOLLO_DIR"

### BINARIES ###
################
echo -e "${YELLOW} ---> Updating system binaries${NC}"
arch=$(uname -m)
install -m 755 \
    "${APOLLO_DIR}/backend/apollo-miner/bin/${arch}/apollo-miner" \
    "${APOLLO_DIR}/backend/apollo-miner/futurebit-miner"
install -m 755 \
    "${APOLLO_DIR}/backend/apollo-miner/bin/${arch}/apollo-miner-v2" \
    "${APOLLO_DIR}/backend/apollo-miner/futurebit-miner-v2"
# Apollo III miner: shipped for aarch64 only.
if [ -f "${APOLLO_DIR}/backend/apollo-miner/bin/${arch}/apollo-miner-v3" ]; then
    install -m 755 \
        "${APOLLO_DIR}/backend/apollo-miner/bin/${arch}/apollo-miner-v3" \
        "${APOLLO_DIR}/backend/apollo-miner/futurebit-miner-v3"
fi
install -m 755 \
    "${APOLLO_DIR}/backend/apollo-miner/bin/${arch}/apollo-helper" \
    "${APOLLO_DIR}/backend/apollo-miner/apollo-helper"
install -m 755 \
    "${APOLLO_DIR}/backend/ckpool/bin/${arch}/ckpool" \
    "${APOLLO_DIR}/backend/ckpool/ckpool"

### SYSTEMD ###
###############
echo -e "${YELLOW} ---> Updating systemd files${NC}"
for unit in \
    apollo-bootstrap.service \
    apollo-api.service \
    apollo-ui-v2.service \
    apollo-miner.service \
    node.service \
    ckpool.service \
    rc-local.service; do
    install -m 644 \
        "${APOLLO_DIR}/backend/systemd/${unit}" \
        "/etc/systemd/system/${unit}"
done
install -m 755 "${APOLLO_DIR}/backend/rc.local" /etc/rc.local

# USB miner hotplug: the per-port template unit (never enabled: udev starts the
# instances) and the udev rule that asks for them.
install -m 644 \
    "${APOLLO_DIR}/backend/systemd/apollo-usb-miner@.service" \
    "/etc/systemd/system/apollo-usb-miner@.service"
install -d -m 755 /etc/udev/rules.d
install -m 644 \
    "${APOLLO_DIR}/backend/udev/99-apollo-usb-miner.rules" \
    /etc/udev/rules.d/99-apollo-usb-miner.rules

# Persistent journald on the eMMC, so an abrupt hang leaves evidence (see
# backend/systemd/journald-apollo.conf). No restart: this is a factory-capture
# flow that leaves services stopped — the config file is on the image and applies
# on the first boot of every device flashed from it.
# Non-fatal: persistent logging is a diagnostic aid, never a reason to abort an
# update or an install half-way (these scripts run under set -e / an ERR trap).
bash "${APOLLO_DIR}/backend/utils/install-journald.sh" "${APOLLO_DIR}" || \
    echo "[journald] WARNING: could not install the journald policy; continuing" >&2

### FACTORY STATE RESET ###
###########################
echo -e "${YELLOW} ---> Removing device-local state for image capture${NC}"
rm -f "${APOLLO_DIR}/futurebit.sqlite"
rm -rf "$STATE_DIR"
rm -f \
    "${APOLLO_DIR}/backend/node/api.conf" \
    "${APOLLO_DIR}/backend/node/user.conf" \
    "${APOLLO_DIR}/backend/node/bitcoin.conf" \
    "${APOLLO_DIR}/backend/node/bitcoind" \
    "${APOLLO_DIR}/backend/ckpool/ckpool.conf"
install -d -o futurebit -g futurebit -m 700 "$STATE_DIR"

systemctl daemon-reload
systemctl enable \
    apollo-bootstrap.service \
    apollo-api.service \
    apollo-ui-v2.service \
    apollo-miner.service \
    node.service \
    rc-local.service
systemctl disable ckpool.service >/dev/null 2>&1 || true
udevadm control --reload-rules

echo -e "${GREEN} ---> Solo Node factory image update complete; services remain stopped${NC}"
