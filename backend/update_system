#!/bin/bash
set -Eeuo pipefail

YELLOW='\033[1;33m'
NC='\033[0m'
TMPFILE="${APOLLO_UPDATE_PROGRESS_FILE:-/tmp/update_progress}"
SOLO_REQUEST_FILE="${APOLLO_SOLO_REQUEST_FILE:-/run/apollo-update-solo-requested-status}"
APOLLO_DIR='/opt/apolloapi'
UI_DIR="${APOLLO_DIR}/apolloui-v2"
STATE_DIR="${APOLLO_STATE_DIR:-/var/lib/apollo}"

# This script stops apollo-api (see stop_runtime_services). The pre-refactor
# updater that calls us is a child of apollo-api, so it shares that unit's cgroup
# and systemd would SIGTERM us along with it, mid-swap. Re-run ourselves as a
# transient service parented by systemd. --wait keeps the caller's exit status
# (the old updater reads it) and, if the caller is killed, the unit carries on.
if [ -z "${APOLLO_UPDATE_SYSTEM_DETACHED:-}" ] &&
   [ -d "${APOLLO_SYSTEMD_DIR:-/run/systemd/system}" ] &&
   command -v systemd-run >/dev/null 2>&1; then
    systemctl reset-failed apollo-update-system.service >/dev/null 2>&1 || true
    exec systemd-run --quiet --collect --wait --unit=apollo-update-system \
        --property=TimeoutStopSec=infinity \
        --setenv=APOLLO_UPDATE_SYSTEM_DETACHED=1 \
        --setenv="APOLLO_STATE_DIR=$STATE_DIR" \
        -- "$0" "$@"
fi

# The API relocates the DB out of the checkout into the state dir (src/paths.js),
# and that can happen while this script runs, so resolve the path at each use
# instead of once at startup. .env is the source of truth, with the managed and
# legacy locations as fallbacks.
resolve_database_url() {
    local from_env='' candidate
    if [ -r "${APOLLO_DIR}/.env" ]; then
        from_env=$(sed -n 's/^DATABASE_URL=//p' "${APOLLO_DIR}/.env" | tail -n 1)
    fi
    for candidate in "$from_env" "${STATE_DIR}/db/futurebit.sqlite" "${APOLLO_DIR}/futurebit.sqlite"; do
        if [ -n "$candidate" ] && [ -f "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

preserve_solo_intent() {
    if [ -e "$SOLO_REQUEST_FILE" ]; then
        return 0
    fi

    local database_url
    if ! database_url=$(resolve_database_url); then
        return 0
    fi

    local requested_status
    requested_status=$(sqlite3 "$database_url" \
        "SELECT COALESCE(requested_status, '')
           FROM service_status
          WHERE service_name = 'solo'
          ORDER BY id DESC
          LIMIT 1;" 2>/dev/null || true)
    (umask 077; printf '%s\n' "$requested_status" > "$SOLO_REQUEST_FILE")
}

restore_solo_intent() {
    [ -f "$SOLO_REQUEST_FILE" ] || return 0

    local database_url
    if ! database_url=$(resolve_database_url); then
        # Keep the marker so a later run can still restore the user's intent
        # instead of silently dropping their solo-mining setting.
        echo -e "${YELLOW}Could not locate the database; keeping preserved solo intent${NC}" >&2
        return 0
    fi

    local requested_status
    requested_status=$(<"$SOLO_REQUEST_FILE")
    case "$requested_status" in
        online|offline)
            sqlite3 "$database_url" \
                "UPDATE service_status
                    SET status = 'pending',
                        requested_status = '${requested_status}',
                        requested_at = CURRENT_TIMESTAMP
                  WHERE service_name = 'solo';"
            ;;
        '')
            sqlite3 "$database_url" \
                "UPDATE service_status
                    SET requested_status = NULL,
                        requested_at = NULL
                  WHERE service_name = 'solo';"
            ;;
    esac

    rm -f "$SOLO_REQUEST_FILE"
}

on_error() {
    local status=$?
    trap - ERR
    restore_solo_intent || true
    # stop_runtime_services took the API down; bring it back so a failed update
    # leaves a device that answers (its service monitor restores node/ckpool).
    systemctl start apollo-api.service >/dev/null 2>&1 || true
    rm -f "$TMPFILE"
    echo "Update failed; the system was not rebooted" >&2
    exit "$status"
}
trap on_error ERR

stop_runtime_services() {
    echo -e "${YELLOW} ---> Stopping API, Bitcoin and CKPool services${NC}"
    # The API goes first. A live 2.1.x API runs a service monitor that records
    # "node stopped" as requested_status='offline' (it cannot tell us from the
    # user), and the bootstrap below moves the database out from under it.
    systemctl stop apollo-api.service
    systemctl stop ckpool.service
    systemctl stop node.service

    if systemctl is-active --quiet ckpool.service ||
       pgrep -u futurebit -x ckpool >/dev/null 2>&1; then
        echo "CKPool did not stop cleanly" >&2
        return 1
    fi
    if systemctl is-active --quiet node.service ||
       pgrep -u futurebit -x bitcoind >/dev/null 2>&1; then
        echo "Bitcoin node did not stop cleanly" >&2
        return 1
    fi
}

preserve_solo_intent

# The updater that launched this script may be from the pre-refactor release.
# Install the new graceful-stop definitions before touching active binaries,
# then stop again even if a newer outer updater already did so.
for unit in \
    apollo-bootstrap.service \
    node.service \
    ckpool.service; do
    install -m 644 \
        "${APOLLO_DIR}/backend/systemd/${unit}" \
        "/etc/systemd/system/${unit}"
done
systemctl daemon-reload
stop_runtime_services

set +u
. /usr/local/nvm/nvm.sh
nvm use 21
set -u

echo "30" > "$TMPFILE"
echo -e "${YELLOW} ---> Updating API modules${NC}"
cd "$APOLLO_DIR"
yarn

echo "40" > "$TMPFILE"
echo -e "${YELLOW} ---> Updating UI modules${NC}"
cd "$UI_DIR"
yarn --ignore-engines

echo "50" > "$TMPFILE"
echo -e "${YELLOW} ---> Building UI (could take a few minutes)${NC}"
rm -rf .next
yarn build

yarn cache clean

echo "70" > "$TMPFILE"
echo -e "${YELLOW} ---> Updating system binaries${NC}"
arch=$(uname -m)
install -m 755 \
    "${APOLLO_DIR}/backend/apollo-miner/bin/${arch}/apollo-miner" \
    "${APOLLO_DIR}/backend/apollo-miner/futurebit-miner"
install -m 755 \
    "${APOLLO_DIR}/backend/apollo-miner/bin/${arch}/apollo-miner-v2" \
    "${APOLLO_DIR}/backend/apollo-miner/futurebit-miner-v2"
# Apollo III miner: shipped for aarch64 only. Guarded because this script runs
# under set -e and an x86_64 dev box has no such binary.
if [ -f "${APOLLO_DIR}/backend/apollo-miner/bin/${arch}/apollo-miner-v3" ]; then
    install -m 755 \
        "${APOLLO_DIR}/backend/apollo-miner/bin/${arch}/apollo-miner-v3" \
        "${APOLLO_DIR}/backend/apollo-miner/futurebit-miner-v3"
fi
install -m 755 \
    "${APOLLO_DIR}/backend/apollo-miner/bin/${arch}/apollo-helper" \
    "${APOLLO_DIR}/backend/apollo-miner/apollo-helper"
install -m 755 \
    "${APOLLO_DIR}/backend/ckpool/bin/${arch}/ckpool" \
    "${APOLLO_DIR}/backend/ckpool/ckpool"

echo "85" > "$TMPFILE"
echo -e "${YELLOW} ---> Validating database and runtime configuration${NC}"
cd "$APOLLO_DIR"
install -d -o futurebit -g futurebit -m 700 "$STATE_DIR"
# Repair a tree an earlier attempt (or the miner unit, which runs as root) left
# root-owned: the bootstrap runs as futurebit and would fail with EACCES.
chown -R futurebit:futurebit "$STATE_DIR"
sudo -u futurebit env \
    NODE_ENV=production \
    APOLLO_STATE_DIR="$STATE_DIR" \
    /usr/local/nvm/versions/node/v21.6.2/bin/node \
    "${APOLLO_DIR}/src/bootstrap.js"

# A live device capable of running the updater has already completed the
# legacy one-time root resize. Factory image updaters delete this marker so
# newly imaged devices still perform their first-boot resize attempt.
install -o futurebit -g futurebit -m 600 \
    /dev/null "${STATE_DIR}/root-resize-attempted"

# Remove legacy runtime copies only after bootstrap has migrated their database
# state and written the durable files under /var/lib/apollo.
rm -f \
    "${APOLLO_DIR}/backend/node/api.conf" \
    "${APOLLO_DIR}/backend/node/user.conf" \
    "${APOLLO_DIR}/backend/node/bitcoin.conf" \
    "${APOLLO_DIR}/backend/node/bitcoind" \
    "${APOLLO_DIR}/backend/ckpool/ckpool.conf"

echo "90" > "$TMPFILE"
echo -e "${YELLOW} ---> Updating systemd files${NC}"
for unit in \
    apollo-bootstrap.service \
    apollo-api.service \
    apollo-ui-v2.service \
    apollo-miner.service \
    node.service \
    ckpool.service \
    rc-local.service \
    swap.service; do
    install -m 644 \
        "${APOLLO_DIR}/backend/systemd/${unit}" \
        "/etc/systemd/system/${unit}"
done
install -m 755 "${APOLLO_DIR}/backend/rc.local" /etc/rc.local

# Persistent journald on the eMMC, so an abrupt hang leaves evidence (see
# backend/systemd/journald-apollo.conf). No restart here: the reboot below applies
# it, and restarting journald under the live services this update runs beneath
# would blip their journal connection.
# Non-fatal: persistent logging is a diagnostic aid, never a reason to abort an
# update or an install half-way (these scripts run under set -e / an ERR trap).
bash "${APOLLO_DIR}/backend/utils/install-journald.sh" "${APOLLO_DIR}" || \
    echo "[journald] WARNING: could not install the journald policy; continuing" >&2

systemctl daemon-reload
systemctl enable \
    apollo-bootstrap.service \
    apollo-api.service \
    apollo-ui-v2.service \
    apollo-miner.service \
    node.service \
    rc-local.service \
    swap.service
systemctl disable ckpool.service >/dev/null 2>&1 || true

restore_solo_intent

echo "100" > "$TMPFILE"
# Long enough for the UI to poll the 100. Removing the file in the same breath
# left the browser with no reading above zero to go on, so a successful update
# was reported as one that gave up before finishing.
sleep 8
rm -f "$TMPFILE"
echo -e "${YELLOW} ---> Rebooting${NC}"
systemctl reboot
