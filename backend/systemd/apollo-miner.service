[Unit]
Description=apollo-miner
# Requires apollo-bootstrap so the futurebit-owned miner runtime dir exists
# before this (root) unit writes stat files into it.
Requires=apollo-bootstrap.service
After=network.target rc-local.service apollo-bootstrap.service

[Service]
Type=forking
User=root
EnvironmentFile=-/opt/apolloapi/.env
#Start:
ExecStart=/opt/apolloapi/backend/apollo-miner/miner_start.sh
WorkingDirectory=/opt/apolloapi/backend/apollo-miner
#Stop:
# miner_start.sh keeps the unit "activating" for ~35s, and a stop in that window
# (or after a crash) never runs ExecStop: systemd goes straight to killing the
# cgroup. ExecStopPost always runs, so it owes the same shutdown; --if-owed makes
# it a no-op when ExecStop already did it.
ExecStop=/opt/apolloapi/backend/apollo-miner/miner_stop.sh
ExecStopPost=-/opt/apolloapi/backend/apollo-miner/miner_stop.sh --if-owed
# On an explicit stop only the main process gets SIGTERM before ExecStopPost; the
# rest of the cgroup (the screen sessions and the miners in them) stays up until
# the shutdown script has run, then gets SIGKILL. With the default (control-group)
# the screen is signalled together with the miner and hangs it up, so the Apollo 3
# binary is cut off in the middle of its own SIGTERM shutdown. Not so after a
# crash of the main process (the screen): systemd then kills the rest of the
# cgroup at once, before ExecStopPost, as the default did before (with SIGHUP).
KillMode=mixed
#Restart
Restart=always
RestartSec=30s

[Install]
WantedBy=multi-user.target
