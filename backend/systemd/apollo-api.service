[Unit]
Description=Apollo API & UI app
Requires=apollo-bootstrap.service
After=network.target apollo-bootstrap.service

[Service]
Environment=NODE_ENV=production
Environment=APOLLO_BOOTSTRAPPED=1
EnvironmentFile=-/opt/apolloapi/.env
Environment=APOLLO_ENV_FILE=/opt/apolloapi/.env
Type=simple
User=futurebit
Group=futurebit
ExecStart=/usr/local/nvm/versions/node/v21.6.2/bin/node /opt/apolloapi/current/src/init.js
WorkingDirectory=/opt/apolloapi/current
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target