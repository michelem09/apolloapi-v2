[Unit]
Description=Apollo API & UI app
Requires=apollo-bootstrap.service
After=network.target apollo-bootstrap.service

[Service]
Environment=NODE_ENV=production
Environment=APOLLO_BOOTSTRAPPED=1
EnvironmentFile=-/opt/apolloapi/.env
Type=simple
User=futurebit
Group=futurebit
# Node comes from the runtime that ships inside the release (backend/runtime/node,
# installed by backend/utils/install-node-runtime.sh), not from nvm. A rollback to a
# release that predates it restores the older unit, which still points at the nvm
# Node 21 that image installs leave on the device.
ExecStart=/opt/apolloapi/backend/runtime/node/bin/node /opt/apolloapi/src/init.js
WorkingDirectory=/opt/apolloapi
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target