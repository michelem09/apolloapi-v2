[Unit]
Description=Apollo App
Documentation=https://nextjs.org/
After=network.target
After=apollo-api.service

[Service]
Type=simple
User=futurebit
Environment=PATH=/opt/apolloapi/backend/runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Run the self-contained build (next.config.js: output: 'standalone') instead of
# `next start`, which needs the full node_modules tree beside it. The standalone
# bundle is ~73 MB against ~700 MB of node_modules, and needs no build step.
#
# WorkingDirectory stays on the UI root and NOT on .next/standalone: the updater
# does `rm -rf .next` before rebuilding, and systemd cannot chdir into a directory
# that no longer exists — a failed build would leave this unit active on a deleted
# working directory and unable to restart. server.js does process.chdir(__dirname)
# itself, so it finds its own files either way.
#
# HOSTNAME is set explicitly on purpose: server.js binds to `process.env.HOSTNAME
# || '0.0.0.0'`, and on Linux that variable is often already the machine name — in
# which case the UI would bind to the loopback and vanish from the LAN.
WorkingDirectory=/opt/apolloapi/apolloui-v2
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3000
# Node comes from the runtime that ships inside the release (backend/runtime/node,
# installed by backend/utils/install-node-runtime.sh), not from nvm. A rollback to a
# release that predates it restores the older unit, which still points at the nvm
# Node 21 that image installs leave on the device.
ExecStart=/opt/apolloapi/backend/runtime/node/bin/node .next/standalone/server.js
Restart=always
SyslogIdentifier=ApolloUIv2

[Install]
WantedBy=multi-user.target