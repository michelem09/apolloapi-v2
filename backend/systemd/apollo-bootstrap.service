[Unit]
Description=Prepare Apollo database and runtime configuration
Wants=network-online.target rc-local.service
After=local-fs.target network-online.target rc-local.service
Before=apollo-api.service node.service

[Service]
Type=oneshot
User=futurebit
Group=futurebit
WorkingDirectory=/opt/apolloapi
Environment=NODE_ENV=production
EnvironmentFile=-/opt/apolloapi/.env
StateDirectory=apollo
StateDirectoryMode=0700
UMask=0077
# Node comes from the runtime that ships inside the release (backend/runtime/node,
# installed by backend/utils/install-node-runtime.sh), not from nvm. A rollback to a
# release that predates it restores the older unit, which still points at the nvm
# Node 21 that image installs leave on the device.
ExecStart=/opt/apolloapi/backend/runtime/node/bin/node /opt/apolloapi/src/bootstrap.js
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
